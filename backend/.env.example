# ARIA v8 — Production .env template
# Copy to .env and fill in your keys

# --- Database ---
POSTGRES_DSN=sqlite:///./data/local_agent.db
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/aria

# --- LLM Providers ---
# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=
DEEPSEEK_API_KEY_4=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Gemini (up to 10 keys via comma-separated)
GEMINI_API_KEY=
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Groq (up to 10 keys via comma-separated)
GROQ_API_KEY=
GROQ_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10

# --- Storage ---
OBSIDIAN_VAULT_PATH=./data/vault
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Runtime ---
HTTP_HOST=127.0.0.1
HTTP_PORT=8765
RUNTIME_TOKEN_PATH=
LOCAL_AGENT_UI_PIN=
LOCAL_AGENT_DISABLE_BOOTSTRAP_WRITE=0

# --- Optional: Codex exec bridge ---
CODEX_ENABLED=false
CODEX_BINARY_PATH=codex
CODEX_SANDBOX_MODE=workspace-write

# --- Telegram notifier (loop-engineering) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

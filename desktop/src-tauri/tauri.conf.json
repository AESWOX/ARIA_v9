{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARIA by aeswox",
  "version": "0.2.1",
  "identifier": "com.local.agent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARIA by aeswox",
        "width": 1600,
        "height": 980,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#041c1c",
        "transparent": false,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* https://tauri.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCQkQ4RDFCRUM3RTk1QUIKUldTcmxYN3NHNDI5dTR2YkoxUGtlUFZPMUZ1MUJJb0NLNVJrY2dsbER3QnpxQWVjSzM4SHpMV2kK",
      "endpoints": [
        "https://github.com/AESWOX/ARIA-locale/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["bin/backend"],
    "resources": ["install_uv.ps1"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installerHooks": "installer-hooks.nsh" }
    }
  }
}

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Frontend
node_modules/
desktop/node_modules/
desktop/node_modules/.cache/
desktop/dist/

# Build artifacts
build/
dist/
src-tauri/target/
src-tauri/gen/
# Nested copies (patterns with a slash are anchored to repo root — cover the
# real paths under desktop/ and backend/ explicitly, otherwise git add -A
# walks gigabytes of Rust cache / PyInstaller output).
desktop/src-tauri/target/
desktop/src-tauri/gen/
backend/dist/
backend/build/
backend/.pytest_cache/

# Sidecar binary is a BUILD OUTPUT (copied by the build script from
# backend/dist/backend.exe) — never keep it in git: 100+ MB per release in
# history and a stale binary that contradicts the source it ships with.
desktop/src-tauri/bin/

# Databases — must never be in version control
*.db
*.db-wal
*.db-shm
*.db-journal
data/

# Logs
logs/
*.log

# Zips — intermediate artifacts
*.zip

# Secrets — must never be in version control
.env
.env.*
*.env
!*.env.example
*.tar.gz

# DoD verification artifacts
.dod_verify.json
coverage.xml
*.orig
*.rej
dod_verify.json
backend/.coverage

# Delivery artifacts
*.bundle
release/
GENSPARK_*
delivery_*
*.patch
aria_full_delivery_audit.ps1

# Binaries are build/installer outputs — never in git (wave 0 review: 3 exe were still tracked)
*.exe
*.msi
